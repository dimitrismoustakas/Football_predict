{
	"encoder_type": "set_transformer",
	"hidden_dim": 64,
	"team_output_dim": 32,
	"num_heads": 4,
	"num_sab_layers": 2,
	"position_embed_dim": 4,
	"dropout": 0.15,
	"use_implied": true,
	"head_type": "mlp",
	"gate_hidden_dim": 32,
	"gate_target_budget": 0.2,
	"market_feature_stats": 3,
	"market_logit_scale": 1.0,
	"learn_market_class_scale": false,
	"aux_context_loss_weight": 0.0,
	"label_smoothing": 0.005,
	"market_target_mix": 0.005,
	"market_target_entropy_scale": 0.0,
	"market_target_entropy_mode": "linear",
	"confidence_penalty_weight": 0.0,
	"brier_aux_weight": 0.0,
	"gce_mix_weight": 0.05,
	"gce_q": 1.25,
	"lr": 0.001,
	"weight_decay": 0.0001,
	"schedule": {
		"name": "onecycle",
		"max_lr": 0.005,
		"pct_start": 0.3
	},
	"batch_size": 256,
	"max_epochs": 35,
	"patience": 5,
	"epoch_smooth_window": 5,
	"min_selection_epoch": 1,
	"top_n_players": 16
}
